\@writefile{toc}{\contentsline {paragraph}{Objection 1: The echo really does decrease the entropy of the spin system, so reversal is at least locally achieved.}{17}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 2: This is just the standard ``the demon pays'' bookkeeping---the entropy goes into the apparatus and environment.}{17}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 3: With a perfect refocusing scheme the deficit would vanish.}{17}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 4: The Loschmidt echo's saturated decay is a feature of chaotic or many-body systems, not a general law.}{17}{section*.7}\protected@file@percent }
