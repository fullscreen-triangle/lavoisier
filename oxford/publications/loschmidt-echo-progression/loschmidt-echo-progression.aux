\@writefile{toc}{\contentsline {paragraph}{Objection 1: The echo really does decrease the entropy of the spin system, so reversal is at least locally achieved.}{18}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 2: This is just the standard ``the demon pays'' bookkeeping---the entropy goes into the apparatus and environment.}{18}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 3: With a perfect refocusing scheme the deficit would vanish.}{18}{section*.6}\protected@file@percent }
\citation{jalabert2001}
\@writefile{toc}{\contentsline {paragraph}{Objection 4: The Loschmidt echo's saturated decay is a feature of chaotic or many-body systems, not a general law.}{19}{section*.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 5: ``Time is a count'' is a redefinition that makes irreversibility true by stipulation, hence empty.}{19}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Objection 6: A time-reversed computer simulation runs fine, so reversal is realisable.}{19}{section*.9}\protected@file@percent }
