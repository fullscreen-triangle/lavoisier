\newlabel{thm:reshuffling}{{5.3}{8}{Reshuffling Theorem}{theorem.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Truth cell theorem: minimum cut sets are cells of positive weight, not points.} (\textbf  {A})~Separation cost $\sigma (v)$ and minimum cut weight $w(C^*(v))$ for nodes $a, b, c, d$ in a five-node graph, shown as grouped bars. The two quantities are equal for every node (confirming Definition~\ref {def:mincutset}), and every value exceeds the contact floor $\beta _{\min }= 0.4$ (dashed line). The truth cell of each node is a set of edges of total weight $\sigma (v) \geq \beta _{\min }$, never a point of weight zero. (\textbf  {B})~Number of edges in the minimum cut set $|C^*(v)|$ for the same four nodes, each equal to three. A cut set containing multiple edges cannot be a point: the truth of $v$ is distributed across the edges of $C^*(v)$, confirming Corollary~\ref {cor:no_point}. (\textbf  {C})~Separation costs $\sigma (v)$ for all eleven nodes across three test graphs, coloured by graph index. The horizontal dashed lines mark the respective contact floors. Every node lies above its graph's floor; the spread within each graph reflects different neighbourhood configurations contributing to individuation. (\textbf  {D})~Three-dimensional bar chart with node index on one horizontal axis, graph index on the other, and $\sigma (v)$ as the bar height. The floor plane (translucent) at $\beta _{\min }$ cuts below every bar, making it geometrically visible that truth is never a point: every truth cell has height strictly above the floor.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:mafg-panel-03}{{3}{9}{\textbf {Truth cell theorem: minimum cut sets are cells of positive weight, not points.} (\textbf {A})~Separation cost $\sigma (v)$ and minimum cut weight $w(C^*(v))$ for nodes $a, b, c, d$ in a five-node graph, shown as grouped bars. The two quantities are equal for every node (confirming Definition~\ref {def:mincutset}), and every value exceeds the contact floor $\bmin = 0.4$ (dashed line). The truth cell of each node is a set of edges of total weight $\sigma (v) \geq \bmin $, never a point of weight zero. (\textbf {B})~Number of edges in the minimum cut set $|C^*(v)|$ for the same four nodes, each equal to three. A cut set containing multiple edges cannot be a point: the truth of $v$ is distributed across the edges of $C^*(v)$, confirming Corollary~\ref {cor:no_point}. (\textbf {C})~Separation costs $\sigma (v)$ for all eleven nodes across three test graphs, coloured by graph index. The horizontal dashed lines mark the respective contact floors. Every node lies above its graph's floor; the spread within each graph reflects different neighbourhood configurations contributing to individuation. (\textbf {D})~Three-dimensional bar chart with node index on one horizontal axis, graph index on the other, and $\sigma (v)$ as the bar height. The floor plane (translucent) at $\bmin $ cuts below every bar, making it geometrically visible that truth is never a point: every truth cell has height strictly above the floor}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The Convergence of Measurement}{9}{subsection.5.2}\protected@file@percent }
\newlabel{cor:convergence}{{5.4}{9}{Measurement Converges to the Floor, Not to a Node}{theorem.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Reshuffling theorem: weight conservation, floor preservation, and growing separation cost.} (\textbf  {A})~Contact floor $\beta _{\min }$ at the initial configuration $G_0$ and after each of five sequential reshufficings $G_1,\ldots  ,G_5$. The horizontal dashed line marks $\beta _{\min }(G_0) = 0.6$. While $\beta _{\min }$ varies across reshufficings, it never falls below $\beta _{\min }(G_0)$, confirming Theorem~\ref {thm:reshuffling}(i): weight-preserving relabellings preserve or increase the contact floor. (\textbf  {B})~Separation cost $\sigma _k(a)$ of node $a$ across the same six configurations, with a trend line overlaid. The sequence is non-decreasing in the mean, confirming Theorem~\ref {thm:reshuffling}(iii): $\sigma (v) \geq \beta _{\min }(G_0) > 0$ after every reshuffling. Reshuffling produces new individuation arrangements without collapsing the truth cell. (\textbf  {C})~Total graph weight $W(G_k) = \DOTSB \sum@ \slimits@ _{e} w(e)$ across all six configurations, constant at $W = 12.6$. This flat line is the graphical statement of conservation: a reshuffling is a weight-preserving operation; matter is not created or destroyed by rearranging contact relations. (\textbf  {D})~Three-dimensional parametric path $(\text  {step}\,k,\, \beta _{\min }(G_k),\, \sigma _k(a))$ connecting the six configurations in reshuffling space. The path wanders in $\beta _{\min }$ and $\sigma $ but remains entirely above the floor plane $\beta _{\min }= 0.6$, making it geometrically clear that no finite sequence of reshufficings reaches the zero boundary.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:mafg-panel-04}{{4}{10}{\textbf {Reshuffling theorem: weight conservation, floor preservation, and growing separation cost.} (\textbf {A})~Contact floor $\bmin $ at the initial configuration $G_0$ and after each of five sequential reshufficings $G_1,\ldots ,G_5$. The horizontal dashed line marks $\bmin (G_0) = 0.6$. While $\bmin $ varies across reshufficings, it never falls below $\bmin (G_0)$, confirming Theorem~\ref {thm:reshuffling}(i): weight-preserving relabellings preserve or increase the contact floor. (\textbf {B})~Separation cost $\sigma _k(a)$ of node $a$ across the same six configurations, with a trend line overlaid. The sequence is non-decreasing in the mean, confirming Theorem~\ref {thm:reshuffling}(iii): $\sigma (v) \geq \bmin (G_0) > 0$ after every reshuffling. Reshuffling produces new individuation arrangements without collapsing the truth cell. (\textbf {C})~Total graph weight $W(G_k) = \sum _{e} w(e)$ across all six configurations, constant at $W = 12.6$. This flat line is the graphical statement of conservation: a reshuffling is a weight-preserving operation; matter is not created or destroyed by rearranging contact relations. (\textbf {D})~Three-dimensional parametric path $(\text {step}\,k,\, \bmin (G_k),\, \sigma _k(a))$ connecting the six configurations in reshuffling space. The path wanders in $\bmin $ and $\sigma $ but remains entirely above the floor plane $\bmin = 0.6$, making it geometrically clear that no finite sequence of reshufficings reaches the zero boundary}{figure.4}{}}
