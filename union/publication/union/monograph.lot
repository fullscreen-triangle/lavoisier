\contentsline {table}{\numberline {25.12}{\ignorespaces Electrical resistivity predictions for four metals. Consequence~\ref {cons:transport} with Drude partition-lag time vs.\ measured values at room temperature.}}{321}{table.caption.151}%
\contentsline {table}{\numberline {25.13}{\ignorespaces Wiedemann--Franz Lorenz numbers across six metals. Framework value $L_0=\pi ^{2}k_B^{2}/(3e^{2})$ is parameter-free; mean absolute error $\sim 9.6$\%.}}{321}{table.caption.152}%
\contentsline {table}{\numberline {25.14}{\ignorespaces Numerical derivation of $c$ from partition lag across six atomic and optical transitions. All predictions match the CODATA value $c=2.99792458\times 10^{8}$ m/s to better than 0.2\%.}}{323}{table.caption.153}%
\contentsline {table}{\numberline {25.15}{\ignorespaces Structural factor $\mathcal {S}$ predicted vs.\ literature across five thermodynamic regimes. A single functional form $PV=Nk_{\mathrm {B}}T\cdot \mathcal {S}$ (Consequence~\ref {cons:universaleos}) captures all five canonical regimes.}}{324}{table.caption.156}%
\contentsline {table}{\numberline {25.16}{\ignorespaces Comparison of $N_{\max }$ with known large numbers. The BPS value is not simply larger but qualitatively different in magnitude class.}}{324}{table.caption.159}%
\contentsline {table}{\numberline {25.17}{\ignorespaces HMR harmonic-edge analysis for six molecules. All mean deviations $\bar \delta < 5$\% threshold (red line in figure). 27 edges total; mean rational-ratio deviation $\bar \delta =0.025$.}}{325}{table.caption.160}%
\contentsline {table}{\numberline {25.18}{\ignorespaces SMSH validation on CH$_{4}^{+}$ ($T_{d}$) and Rhodamine 6G ($C_{2}$). All four observables are direct measurements of S-entropy coordinate sufficiency (Consequence~\ref {cons:quantumnumbers}) and the triple-equivalence theorem (Consequence~\ref {cons:tripleent}).}}{326}{table.caption.161}%
\contentsline {table}{\numberline {25.19}{\ignorespaces Multi-Modal Virtual Spectrometer (MMVS) validation across nine NIST reference elements spanning all four atomic blocks. Mean absolute error $0.021$\%; 27/27 cross-modality agreements.}}{326}{table.caption.162}%
\contentsline {table}{\numberline {25.20}{\ignorespaces Empirical predictions by physical domain: 142 total, median absolute relative error 11\%, 60 of 142 agreeing within 1\%. The dynamic range spans 24 orders of magnitude in physical scale.}}{327}{table.caption.163}%
\contentsline {table}{\numberline {25.22}{\ignorespaces All 142 empirical confirmations of the Bounded Phase Space Law. Pred.\ = prediction number (within domain group). Agreement: absolute relative error $|$pred $-$ meas$|/|$meas$|$.}}{327}{table.25.22}%
