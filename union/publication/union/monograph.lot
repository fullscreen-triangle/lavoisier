\contentsline {table}{\numberline {25.7}{\ignorespaces Photoelectric threshold frequencies for selected metals. Below $\nu _{0}$, no photoemission regardless of light intensity --- a direct confirmation of Consequence~\ref {cons:energyfrequency}.}}{316}{table.caption.146}%
